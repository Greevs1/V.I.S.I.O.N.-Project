{
  "name": "Sprint Item Completed \u2192 Outcome Record",
  "description": "When a SprintTask is marked completed, automatically creates a strategy_outcomes record (source_type=sprint_item) for Outcome Tracking.",
  "trigger": {
    "condition": "${ ((.trigger.data.status == \"completed\") and (.trigger.changed_fields | index(\"status\") != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "SprintTask"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "sprint_item_completed_outcome_record",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onSprintItemCompleted",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "onSprintItemCompleted"
  }
}