{
  "name": "NotificationPreferences",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Base44 user ID"
    },
    "in_app_notifications_enabled": {
      "type": "boolean",
      "default": true
    },
    "email_notifications_enabled": {
      "type": "boolean",
      "default": true
    },
    "reminder_notifications_enabled": {
      "type": "boolean",
      "default": true
    },
    "task_assignment_notifications_enabled": {
      "type": "boolean",
      "default": true
    },
    "document_request_notifications_enabled": {
      "type": "boolean",
      "default": true
    },
    "resource_assignment_notifications_enabled": {
      "type": "boolean",
      "default": true
    },
    "team_invite_notifications_enabled": {
      "type": "boolean",
      "default": true
    },
    "booking_notifications_enabled": {
      "type": "boolean",
      "default": true
    },
    "sprint_completion_notifications_enabled": {
      "type": "boolean",
      "default": true
    },
    "galileo_update_notifications_enabled": {
      "type": "boolean",
      "default": true
    },
    "weekly_summary_enabled": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}