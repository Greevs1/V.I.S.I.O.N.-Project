{
  "name": "ValuationChangeRequest",
  "type": "object",
  "properties": {
    "valuation_id": {
      "type": "string",
      "description": "Valuation ID"
    },
    "business_id": {
      "type": "string",
      "description": "Business ID for scoping"
    },
    "field_key": {
      "type": "string",
      "description": "Field the change is requested for"
    },
    "field_display_name": {
      "type": "string"
    },
    "requestor_id": {
      "type": "string",
      "description": "Profile ID of the user requesting the change"
    },
    "requestor_name": {
      "type": "string"
    },
    "requestor_role": {
      "type": "string",
      "enum": [
        "owner",
        "team_member",
        "viewer"
      ],
      "default": "viewer",
      "description": "Role of the requestor (read-only users request changes)"
    },
    "current_value_summary": {
      "type": "string",
      "description": "What the field currently shows"
    },
    "proposed_value_summary": {
      "type": "string",
      "description": "What the requestor believes it should be"
    },
    "reason": {
      "type": "string",
      "description": "Why the change is requested"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "withdrawn"
      ],
      "default": "pending"
    },
    "reviewer_id": {
      "type": "string",
      "description": "Advisor profile ID who reviewed the request"
    },
    "reviewer_name": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "review_notes": {
      "type": "string"
    }
  },
  "required": [
    "valuation_id",
    "field_key",
    "requestor_id",
    "reason"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "super_admin"
      }
    }
  }
}