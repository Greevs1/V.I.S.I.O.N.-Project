{
  "name": "ValuationFieldGovernance",
  "type": "object",
  "properties": {
    "valuation_id": {
      "type": "string",
      "description": "Valuation ID this field belongs to"
    },
    "business_id": {
      "type": "string",
      "description": "Business ID for scoping"
    },
    "field_key": {
      "type": "string",
      "description": "Canonical field key (e.g. revenue_2024, ebitda_multiple)"
    },
    "field_display_name": {
      "type": "string",
      "description": "Human-readable field name"
    },
    "field_category": {
      "type": "string",
      "enum": [
        "financial",
        "methodology",
        "adjustment",
        "conclusion",
        "confidence",
        "scenario",
        "driver"
      ],
      "default": "financial"
    },
    "current_owner_id": {
      "type": "string",
      "description": "Advisor profile ID who owns this field"
    },
    "current_owner_name": {
      "type": "string"
    },
    "is_locked": {
      "type": "boolean",
      "default": true,
      "description": "True if field is locked; only owner/lead/super_admin may unlock"
    },
    "locked_by_id": {
      "type": "string"
    },
    "locked_by_name": {
      "type": "string"
    },
    "locked_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_modified_by_id": {
      "type": "string"
    },
    "last_modified_by_name": {
      "type": "string"
    },
    "last_modified_at": {
      "type": "string",
      "format": "date-time"
    },
    "change_reason": {
      "type": "string",
      "description": "Reason for the last change"
    },
    "source_of_truth": {
      "type": "string",
      "enum": [
        "document",
        "assessment",
        "advisor_judgment",
        "ai_extraction",
        "client_confirmation",
        "benchmark"
      ],
      "default": "advisor_judgment"
    },
    "source_reference": {
      "type": "string",
      "description": "Document ID, assessment ID, or other source reference"
    },
    "source_reference_name": {
      "type": "string"
    },
    "confidence_score": {
      "type": "number",
      "description": "0-100 confidence in the current value"
    },
    "current_value_summary": {
      "type": "string",
      "description": "Human-readable snapshot of the current value"
    },
    "ai_recommendation_id": {
      "type": "string",
      "description": "Linked AI recommendation if source is AI extraction"
    },
    "ai_recommendation_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "modified"
      ],
      "default": "pending",
      "description": "AI never writes directly; recommendations must be approved/rejected/modified"
    }
  },
  "required": [
    "valuation_id",
    "field_key"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "super_admin"
      }
    }
  }
}