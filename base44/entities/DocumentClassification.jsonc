{
  "name": "DocumentClassification",
  "type": "object",
  "properties": {
    "document_id": {
      "type": "string",
      "description": "Supabase document ID"
    },
    "document_name": {
      "type": "string"
    },
    "profile_id": {
      "type": "string"
    },
    "business_id": {
      "type": "string"
    },
    "suggested_folder": {
      "type": "string",
      "description": "System folder ID"
    },
    "suggested_subfolder": {
      "type": "string"
    },
    "applied_folder": {
      "type": "string"
    },
    "confidence_score": {
      "type": "number",
      "description": "0-100"
    },
    "classification_status": {
      "type": "string",
      "enum": [
        "pending",
        "auto_filed",
        "awaiting_review",
        "approved",
        "rejected",
        "overridden"
      ],
      "default": "pending"
    },
    "classification_source": {
      "type": "string",
      "enum": [
        "galileo_auto",
        "galileo_suggest",
        "user_manual",
        "admin_manual"
      ],
      "default": "galileo_suggest"
    },
    "reasoning": {
      "type": "string"
    },
    "document_type": {
      "type": "string"
    },
    "extracted_keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tax_year": {
      "type": "string"
    },
    "reviewed_by_id": {
      "type": "string"
    },
    "reviewed_by_name": {
      "type": "string"
    },
    "reviewed_by_role": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "original_folder": {
      "type": "string",
      "default": "inbox"
    },
    "filed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "document_id",
    "document_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}