{
  "name": "DocumentRequest",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "uploaded",
        "under_review",
        "complete"
      ],
      "default": "pending"
    },
    "request_type": {
      "type": "string",
      "enum": [
        "document",
        "financial",
        "tax",
        "legal",
        "other"
      ],
      "default": "document"
    },
    "requested_by": {
      "type": "string"
    },
    "requested_for_profile_id": {
      "type": "string"
    },
    "requested_for_business_id": {
      "type": "string"
    },
    "requested_for_email": {
      "type": "string"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "fulfilled_file_url": {
      "type": "string"
    },
    "fulfilled_document_id": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.requested_for_profile_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.requested_for_profile_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}