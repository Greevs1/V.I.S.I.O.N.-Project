{
  "name": "WeeklyDigest",
  "type": "object",
  "properties": {
    "profile_id": {
      "type": "string"
    },
    "business_id": {
      "type": "string"
    },
    "digest_start_date": {
      "type": "string",
      "format": "date"
    },
    "digest_end_date": {
      "type": "string",
      "format": "date"
    },
    "headline": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "wins": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "progress": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "value_created": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "opportunities_discovered": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "outcomes_verified": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "freedom_changes": {
      "type": "object"
    },
    "next_best_actions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "advisor_notes": {
      "type": "string"
    },
    "digest_data": {
      "type": "object"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "profile_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "data.profile_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}