{
  "name": "KnowledgeBaseEntry",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Title/summary of the knowledge insight"
    },
    "content": {
      "type": "string",
      "description": "Full knowledge insight content"
    },
    "category": {
      "type": "string",
      "enum": [
        "financial",
        "tax",
        "operations",
        "legal",
        "strategy",
        "market",
        "exit",
        "general"
      ],
      "default": "general"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "document",
        "assessment",
        "advisor_note",
        "chat",
        "galileo_insight",
        "opportunity"
      ]
    },
    "source_id": {
      "type": "string"
    },
    "source_name": {
      "type": "string"
    },
    "confidence_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "business_id": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "reviewed",
        "published",
        "archived"
      ],
      "default": "draft"
    },
    "reviewed_by": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "title",
    "content"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}