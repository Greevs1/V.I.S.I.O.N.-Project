{
  "name": "WorksheetResponse",
  "type": "object",
  "properties": {
    "worksheet_id": {
      "type": "string"
    },
    "worksheet_assignment_id": {
      "type": "string"
    },
    "profile_id": {
      "type": "string"
    },
    "business_id": {
      "type": "string"
    },
    "response_data": {
      "type": "object"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "submitted",
        "completed"
      ],
      "default": "draft"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "submitted_by": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "worksheet_id",
    "profile_id",
    "response_data"
  ],
  "rls": {
    "create": {
      "data.profile_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "data.profile_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "data.profile_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}