{
  "name": "LiveSyncAction",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Business State Event ID that triggered this action"
    },
    "business_id": {
      "type": "string",
      "description": "Business ID this action is scoped to"
    },
    "fact_key": {
      "type": "string",
      "description": "Canonical fact key (e.g. revenue)"
    },
    "consumer_id": {
      "type": "string",
      "enum": [
        "dashboard",
        "galileo",
        "executive_brief",
        "growth_plan",
        "reports",
        "meeting_prep",
        "business_intelligence",
        "assessments",
        "valuation",
        "documents",
        "roadmap",
        "sprints"
      ],
      "description": "Consumer that should act on this event"
    },
    "mode": {
      "type": "string",
      "enum": [
        "live",
        "shadow"
      ],
      "description": "Whether this action is live or shadow"
    },
    "action_type": {
      "type": "string",
      "enum": [
        "invalidate",
        "record_only",
        "fallback"
      ],
      "description": "Type of action the consumer should take"
    },
    "qualification_result": {
      "type": "object",
      "description": "Event qualification check results"
    },
    "governance_classification": {
      "type": "string",
      "enum": [
        "automatic",
        "advisor_review",
        "verification_required",
        "blocked"
      ],
      "description": "Governance classification for this consumer"
    },
    "circuit_breaker_tripped": {
      "type": "boolean",
      "default": false,
      "description": "True if circuit breaker was tripped for this consumer"
    },
    "circuit_breaker_reason": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "failed",
        "fallback_used",
        "shadow_recorded"
      ],
      "default": "pending",
      "description": "Status of this live sync action"
    },
    "error_class": {
      "type": "string",
      "description": "Error class if the action failed"
    },
    "refresh_duration_ms": {
      "type": "number",
      "description": "Duration of the refresh in milliseconds"
    },
    "deduplicated": {
      "type": "boolean",
      "default": false,
      "description": "True if this action was deduplicated"
    },
    "reason": {
      "type": "string",
      "description": "Human-readable reason for this action"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "event_id",
    "business_id",
    "fact_key",
    "consumer_id",
    "mode"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "super_admin"
      }
    }
  }
}