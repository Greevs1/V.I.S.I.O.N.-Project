{
  "name": "DocumentFolder",
  "type": "object",
  "properties": {
    "profile_id": {
      "type": "string"
    },
    "business_id": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "parent_folder_id": {
      "type": "string"
    },
    "is_system": {
      "type": "boolean",
      "default": false
    },
    "system_folder_id": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "hidden": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "label"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    }
  }
}