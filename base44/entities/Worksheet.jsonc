{
  "name": "Worksheet",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Worksheet title"
    },
    "folder": {
      "type": "string",
      "enum": [
        "Worksheet Templates",
        "Session Templates",
        "Metric Templates"
      ],
      "default": "Worksheet Templates"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published"
      ],
      "default": "draft"
    },
    "fields": {
      "type": "array",
      "description": "Array of field definitions",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "textarea",
              "checkbox",
              "dropdown",
              "number",
              "date",
              "signature"
            ]
          },
          "placeholder": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "assigned_to": {
      "type": "array",
      "description": "User IDs this worksheet is assigned to",
      "items": {
        "type": "string"
      }
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "tax",
        "entity",
        "operations",
        "exit",
        "general"
      ],
      "default": "general"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}