{
  "name": "galileo_opportunity_score_history",
  "type": "object",
  "properties": {
    "opportunity_id": {
      "type": "string"
    },
    "generation_id": {
      "type": "string"
    },
    "impact_score": {
      "type": "number"
    },
    "ease_score": {
      "type": "number"
    },
    "urgency_score": {
      "type": "number"
    },
    "confidence_score": {
      "type": "number"
    },
    "time_to_value_score": {
      "type": "number"
    },
    "strategic_opportunity_score": {
      "type": "number"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "opportunity_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}