{
  "name": "SprintTask",
  "type": "object",
  "properties": {
    "sprint_id": {
      "type": "string"
    },
    "parent_task_id": {
      "type": "string"
    },
    "task_type": {
      "type": "string",
      "enum": [
        "main_task",
        "subtask"
      ],
      "default": "main_task"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "month_number": {
      "type": "number"
    },
    "week_number": {
      "type": "number"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "assigned_to_name": {
      "type": "string"
    },
    "assigned_to_email": {
      "type": "string"
    },
    "assigned_to_id": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium"
    },
    "ease": {
      "type": "string",
      "enum": [
        "easy",
        "medium",
        "advanced"
      ],
      "default": "medium"
    },
    "impact": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium"
    },
    "expected_outcome": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "completed",
        "blocked"
      ],
      "default": "not_started"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_by": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_galileo_generated": {
      "type": "boolean",
      "default": false
    },
    "is_user_created": {
      "type": "boolean",
      "default": false
    },
    "locked": {
      "type": "boolean",
      "default": false
    },
    "estimated_time": {
      "type": "string"
    },
    "business_id": {
      "type": "string"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time"
    },
    "deleted_by": {
      "type": "string"
    },
    "expert_needed": {
      "type": "boolean",
      "default": false
    },
    "recommended_expert_type": {
      "type": "string"
    },
    "expert_reason": {
      "type": "string"
    },
    "expert_priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    }
  },
  "required": [
    "sprint_id",
    "title"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.assigned_to_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.assigned_to_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}